# ──────────────────────────────────────────────
# .env.example — Copy this to .env and fill in values
# NEVER commit your real .env file to git
# ──────────────────────────────────────────────

# ── JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS: Comma-separated list of allowed frontend origins
# Dev:  http://localhost:8000,http://localhost:3000
# Prod: https://medicore.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── Database URL (leave as-is for SQLite, change for PostgreSQL in production)
DATABASE_URL=sqlite:///./medicore.db
# DATABASE_URL=postgresql://user:password@localhost:5432/medicore

# ── App environment: development | production
APP_ENV=development
